# Copy this file to .env.local for local development.
# In production, set these in Vercel → Settings → Environment Variables.

# ─── NextAuth (required) ──────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Google OAuth (required for sign-in) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Postgres (auto-injected by Vercel Postgres) ──────────────────
# Don't paste these manually if you used Vercel Storage → Create Postgres.
# Vercel sets POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, etc. automatically.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ─── Stripe (required for live checkout) ──────────────────────────
# From Stripe Dashboard → Developers → API keys.
# Use test-mode keys (sk_test_*, pk_test_*) during development,
# live keys (sk_live_*, pk_live_*) for production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard → Developers → Webhooks → endpoint signing secret.
STRIPE_WEBHOOK_SECRET=

# ─── Google Sheets live delivery (service account) ────────────────
# Lets Advertisely append each new lead into a customer's Google Sheet.
# Setup: Google Cloud Console → create a project → enable the "Google Sheets
# API" → create a Service Account → create a JSON key. From that JSON, copy
# "client_email" and "private_key" below. Customers then share their sheet with
# the client_email address (as Editor). Without these, live Sheets delivery is
# simply disabled (the connect card shows "not enabled yet").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value exactly as it appears in the JSON, including the
# \n escape sequences and the BEGIN/END lines, wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ─── Admin access ─────────────────────────────────────────────────
# Comma-separated emails that should get the ADMIN role automatically
# (grants access to /admin, including the Meta ingestion setup). Use the
# email you sign in with. Example: ADMIN_EMAILS=you@gmail.com,partner@gmail.com
ADMIN_EMAILS=

# ─── Inbound lead capture (Make.com / Zapier bridge) ──────────────
# A no-code connector (Make.com or Zapier) forwards Facebook leads to
# POST /api/webhooks/inbound?key=YOUR_SECRET . Pick any long random string for
# the secret and paste the same value into the connector. Without this, the
# inbound endpoint is disabled. Optional: set a default package for leads that
# don't specify one.
INBOUND_LEAD_SECRET=
INBOUND_DEFAULT_PACKAGE_ID=blue-collar-iul

# ─── Meta Lead Ads webhook ────────────────────────────────────────
# Pick any random string for the verify token; paste the same string into
# Meta App settings when configuring the webhook.
META_VERIFY_TOKEN=
# From Meta App → Settings → Basic → App Secret (click "Show").
META_APP_SECRET=

# ─── Email delivery via Resend (required to send any email) ───────
# Sign up at https://resend.com, then API Keys → Create API Key.
# Without this, ALL emails (lead delivery, order confirmation, thank-you)
# are silently skipped.
RESEND_API_KEY=
# The "from" address. The domain MUST be verified in Resend
# (Resend → Domains → add advertisely.io, then add the SPF/DKIM DNS records
# at GoDaddy). Until the domain is verified, only onboarding@resend.dev works
# and it only delivers to the Resend account owner.
EMAIL_FROM="Advertisely <leads@advertisely.io>"
