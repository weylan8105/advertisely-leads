// Advertisely Leads — Prisma schema
// Reference: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth models ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Set for email/password accounts; null for OAuth-only (e.g. Google) users.
  passwordHash  String?
  agency        String?
  role          UserRole  @default(AGENT)
  state         String?
  createdAt     DateTime  @default(now())

  accounts              Account[]
  sessions              Session[]
  orders                Order[]
  assignedLeads         Lead[]               @relation("AssignedAgent")
  integrations          Integration[]
  exportLogs            ExportLog[]
  tasks                 Task[]
  requestedReplacements ReplacementRequest[] @relation("RequestedReplacements")
  reviewedReplacements  ReplacementRequest[] @relation("ReviewedReplacements")

  // Teams / multi-seat (Phase 1)
  defaultOrganizationId String?
  ownedOrganizations    Organization[] @relation("OrgOwner")
  memberships           Membership[]
  sentInvitations       Invitation[]   @relation("InvitedBy")
}

enum UserRole {
  AGENT
  AGENCY_OWNER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Meta integration (admin-owned) ──────────────────────────────────

// One row per Meta Page that we ingest leads from.
// Admin-only; customers never touch this.
model MetaPageConnection {
  id                String    @id @default(cuid())
  pageId            String    @unique
  pageName          String
  pageAccessToken   String    @db.Text
  enabled           Boolean   @default(true)
  // Set when the page is successfully subscribed to the app's `leadgen` field
  // (POST /{page-id}/subscribed_apps). Until this is set, Meta will NOT send
  // leadgen webhooks for this page, so no leads can flow.
  subscribedAt      DateTime?
  // Last error from token validation or the subscribe call, surfaced in admin UI.
  subscriptionError String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  formMappings MetaFormMapping[]
}

// Maps a specific Meta Lead Ad Form to an Advertisely package.
// e.g. "Lineman Retirement Q2" form_id 12345 → "blue-collar-iul" package.
model MetaFormMapping {
  id               String             @id @default(cuid())
  formId           String             @unique
  formName         String
  packageId        String // matches LeadPackageId in TypeScript
  pageConnectionId String
  enabled          Boolean            @default(true)
  // Mapping from Meta form question key → our standardized field name.
  // E.g. {"what_state_do_you_live_in?": "state", "your_occupation?": "occupation"}
  fieldMapping     Json               @default("{}")
  createdAt        DateTime           @default(now())
  pageConnection   MetaPageConnection @relation(fields: [pageConnectionId], references: [id], onDelete: Cascade)
}

// ─── Lead pipeline ───────────────────────────────────────────────────

model Lead {
  id              String        @id @default(cuid())
  externalId      String?       @unique // Meta leadgen_id (legacy)
  ghlContactId    String?       @unique // GHL contact id — arrives with GHL intake; powers sold-tagging
  ghlSoldTaggedAt DateTime? // set when we tag the GHL contact advertisely-sold
  name            String
  phone           String
  email           String
  state           String
  age             Int?
  income          Int?
  occupation      String?
  intentReason    String?       @db.Text
  packageId       String // which package this lead belongs to
  status          LeadStatus    @default(NEW)
  disposition     String?
  pipelineStage   String        @default("new-lead") // CRM kanban stage id (see data/pipeline.ts)
  soldPremiumCents Int?         // annual premium (AP) logged when moved to Issued PAID — powers P&L
  soldAt          DateTime?
  callbackAt      DateTime?     // scheduled call-back reminder (card counts down / flashes when due)
  source          String // e.g. "Meta - Lineman Retirement Q2"
  campaignName    String?
  adsetId         String?
  creativeId      String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  fbclid          String?
  consentMethod   ConsentMethod @default(TCPA_WEB_FORM)
  consentTime     DateTime
  consentIp       String?
  trustedFormUrl  String?
  // Every question/answer from the Meta instant form, even ones we don't model
  rawFormData     Json          @default("{}")
  tags            String[]      @default([])
  callAttempts    Int           @default(0)
  lastContactedAt DateTime?
  receivedAt      DateTime      @default(now())

  // Assignment + order
  assignedUserId String?
  assignedAt     DateTime?
  orderId        String?
  organizationId String? // team that owns this lead (Phase 1)
  assignedUser   User?         @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  order          Order?        @relation(fields: [orderId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  notes               LeadNote[]
  tasks               Task[]
  activity            LeadActivity[]
  exportLogs          ExportLog[]
  replacementRequests ReplacementRequest[]

  @@index([state, packageId, status, assignedUserId])
  @@index([receivedAt])
  @@index([organizationId])
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SET
  NO_ANSWER
  BAD_NUMBER
  CLOSED
  REPLACED
}

enum ConsentMethod {
  TCPA_WEB_FORM
  TRUSTED_FORM
  JORNAYA
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  author    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  type      ActivityType
  author    String?
  body      String       @db.Text
  metadata  Json?
  createdAt DateTime     @default(now())
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  LEAD_RECEIVED
  LEAD_ASSIGNED
  CALL_MADE
  EMAIL_SENT
  SMS_SENT
  NOTE_ADDED
  STATUS_CHANGED
  APPOINTMENT_SET
  EXPORTED_CRM
  TAG_ADDED
  REPLACEMENT_REQUESTED
}

model Task {
  id         String   @id @default(cuid())
  leadId     String
  assignedTo String
  type       TaskType
  title      String
  dueAt      DateTime
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
}

enum TaskType {
  CALL
  EMAIL
  SMS
  APPOINTMENT
  FOLLOW_UP
}

// ─── Orders + fulfillment ────────────────────────────────────────────

model Order {
  id                    String        @id @default(cuid())
  userId                String
  packageId             String
  quantity              Int
  pricePerLeadCents     Int
  totalCents            Int
  // Filters that gate which leads can fulfill this order
  filterStates          String[]      @default([])
  filterIncomeMin       Int?
  filterAgeMinDays      Int?
  filterAgeMaxDays      Int?
  status                OrderStatus   @default(PENDING)
  fulfilledCount        Int           @default(0)
  // Optional per-order Google Sheet. When set, this order's leads sync here
  // instead of the customer's default connected sheet.
  sheetOverrideId       String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  fulfilledAt           DateTime?
  organizationId        String? // team that placed this order (Phase 1)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization? @relation(fields: [organizationId], references: [id])
  leads                 Lead[]

  @@index([status])
  @@index([organizationId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERING
  DELIVERED
  REFUNDED
}

// ─── Customer integrations (GHL, Sheets, Webhook) ────────────────────

model Integration {
  id         String          @id @default(cuid())
  userId     String
  type       IntegrationType
  enabled    Boolean         @default(true)
  // Encrypted credentials: { apiKey, locationId, sheetUrl, webhookUrl, etc. }
  config     Json
  lastUsedAt DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

enum IntegrationType {
  GOHIGHLEVEL
  GOOGLE_SHEETS
  WEBHOOK
  SALESFORCE
  HUBSPOT
  ZAPIER
}

// ─── Export audit log ────────────────────────────────────────────────

model ExportLog {
  id           String       @id @default(cuid())
  userId       String
  leadId       String?
  destination  String // 'ghl', 'sheets', 'webhook', etc.
  status       ExportStatus @default(SUCCESS)
  responseCode Int?
  errorMessage String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum ExportStatus {
  SUCCESS
  FAILED
  PENDING
}

// ─── Replacement requests ─────────────────────────────────────────────
model ReplacementRequest {
  id            String            @id @default(cuid())
  leadId        String
  reason        String            @db.Text
  status        ReplacementStatus @default(PENDING)
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  adminNote     String?           @db.Text
  createdAt     DateTime          @default(now())

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedReplacements", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("ReviewedReplacements", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([leadId])
}

enum ReplacementStatus {
  PENDING
  APPROVED
  DENIED
}

// ─── Teams / multi-seat + lead distribution (Phase 1) ────────────────

// An agency/team account. Every user gets a personal Organization they own;
// owners can invite additional seats (agents) and route purchased leads to
// them. Leads and Orders are stamped with the owning organization.
model Organization {
  id               String           @id @default(cuid())
  name             String
  ownerId          String
  // How purchased leads are handed out to the team.
  distributionMode DistributionMode @default(MANUAL)
  // Round-robin pointer — advanced each time a lead is auto-assigned so the
  // rotation is fair and survives across separate fulfillment runs.
  rrCursor         Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner       User         @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]
  orders      Order[]
  leads       Lead[]

  @@index([ownerId])
}

// A user's seat within an organization, with a role and rotation flag.
model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(AGENT)
  // Whether this member receives leads under ROUND_ROBIN distribution.
  inRotation     Boolean        @default(true)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// A pending seat invite. May be sent to someone without an account yet; the
// Membership is created when they accept (sign in with the invited email).
model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(AGENT)
  token          String           @unique @default(cuid())
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DistributionMode {
  MANUAL // all purchased leads go to the buyer/owner; reassign by hand
  ROUND_ROBIN // purchased leads are spread across in-rotation members
}
